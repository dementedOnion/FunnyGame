FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /source

COPY src/FunnyGame.Shared/FunnyGame.Shared.csproj src/FunnyGame.Shared/
COPY src/FunnyGame.Server/FunnyGame.Server.csproj src/FunnyGame.Server/
RUN dotnet restore src/FunnyGame.Server/FunnyGame.Server.csproj

COPY src/FunnyGame.Shared/ src/FunnyGame.Shared/
COPY src/FunnyGame.Server/ src/FunnyGame.Server/
RUN dotnet publish src/FunnyGame.Server/FunnyGame.Server.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app .
ENV PORT=10000
EXPOSE 10000
ENTRYPOINT ["dotnet", "FunnyGame.Server.dll"]
